# Offline/minimal runtime image. Run `make container-offline`; it supplies the
# statically linked binary and a CA bundle from the build host.
FROM scratch
COPY bin/crproxy /crproxy
COPY LICENSE NOTICE /licenses/
COPY deploy/container/crproxy.yaml /etc/crproxy/crproxy.yaml
COPY ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --chown=65532:65532 deploy/container/data/. /var/lib/crproxy/
USER 65532:65532
EXPOSE 5000 5443
VOLUME ["/var/lib/crproxy"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["/crproxy", "healthcheck", "-url", "http://127.0.0.1:5000/readyz"]
ENTRYPOINT ["/crproxy", "serve", "-config", "/etc/crproxy/crproxy.yaml"]
